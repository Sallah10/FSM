# Copy this file to .env.local and fill in the values.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# Postgres connection string. Any TCP Postgres works, but production targets
# Supabase (we use its Realtime for live chat/updates).
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler"
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave blank locally to use the embedded PGlite database instead - no install required.
DATABASE_URL=

# Where the local embedded Postgres keeps its files.
PGLITE_PATH=./.pgdata

# Supabase Realtime. Find these under Project Settings -> API. Leave blank to
# disable live chat/updates (the app falls back to REST polling/refresh).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> JWT Settings -> JWT Secret (used to sign the token
# our /api/realtime/token route hands to the browser).
SUPABASE_JWT_SECRET=

# Optional Google OAuth. Leave blank to hide the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false
