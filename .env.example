# Copy this file to .env.local and fill in the values.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# Postgres connection string (Neon in production). Leave blank locally to use the
# embedded PGlite database instead - no install required.
# Neon example: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/quickset?sslmode=require
DATABASE_URL=

# Where the local embedded Postgres keeps its files.
PGLITE_PATH=./.pgdata

# Optional Google OAuth. Leave blank to hide the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false
